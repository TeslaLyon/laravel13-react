APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_QUERY=false

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 对象存储配置 (兼容 S3 协议，零出口流量费)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_URL=https://assets.yourdomain.com
R2_USE_PATH_STYLE_ENDPOINT=false

# 静态资源 CDN 加速域名 (可选，留空时默认读取应用本地静态资源)
CDN_URL=

VITE_APP_NAME="${APP_NAME}"

PUSHER_APP_ID=app-id
PUSHER_APP_KEY=app-key
PUSHER_APP_SECRET=app-secret

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700

MEILISEARCH_NO_ANALYTICS=false

WWWGROUP=1000
WWWUSER=1000

OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false

COMPOSE_FILE=compose.yaml

RESEND_API_KEY="re_你的真实密钥"

# V免签独立服务配置（同机 Docker 内网通信推荐 http://vmq-app:8081）
VMQ_GATEWAY_URL="http://app:8080"
VMQ_CASHIER_URL="https://your-vmq-domain.com"
VMQ_APP_KEY="sssss"
VMQ_APP_SECRET="your_custom_secure_salt_here"
VMQ_API_TIMEOUT=15
VMQ_API_CONNECT_TIMEOUT=5
VMQ_API_MAX_RETRIES=2

# Cloudflare Turnstile 人机验证配置 (可选，留空则自动跳过人机验证)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
